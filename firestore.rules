rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ============================================================
    // PROJIFYRA 3.1 — Security Rules
    // Master Super Admin: hyprpranav@gmail.com
    // ============================================================

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isMasterAdmin() {
      return isAuthenticated() && 
        request.auth.token.email.lower() == 'hyprpranav@gmail.com';
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // 1. Users Directory (clients, officers, admins)
    match /users/{userId} {
      // Authenticated users can read directory / profiles
      allow read: if isAuthenticated();
      
      // User creates their own profile upon registration
      allow create: if isAuthenticated() && request.auth.uid == userId;
      
      // Self-update profile (cannot self-escalate role unless Master Admin)
      allow update: if isMasterAdmin() || (
        isOwner(userId) && 
        (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['role']))
      );
      
      // Only Master Admin can delete user accounts
      allow delete: if isMasterAdmin();
    }

    // 2. Showcase Projects Catalog (Public)
    match /projects/{projectId} {
      // Anyone (visitors and students) can browse showcase projects
      allow read: if true;
      
      // Only Master Admin can publish, edit, or delete projects
      allow create, update, delete: if isMasterAdmin();
    }

    // 3. Project Requests (Submitted ideas by students)
    match /projectRequests/{requestId} {
      // Anyone (students submitting ideas, authenticated or applicants) can submit a request
      allow create: if true;
      
      // Student can view their own request (by UID or email); Admin and Officers can view all
      allow read: if isAuthenticated() && (
        resource.data.clientId == request.auth.uid || 
        resource.data.email == request.auth.token.email ||
        isMasterAdmin() || 
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['admin', 'officer']
      );
      
      // Student can update their pending request; Admin/Officer can update status
      allow update: if isAuthenticated() && (
        resource.data.clientId == request.auth.uid || 
        resource.data.email == request.auth.token.email ||
        isMasterAdmin() || 
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['admin', 'officer']
      );
      
      // Master Admin can delete requests
      allow delete: if isMasterAdmin();
    }

    // 4. Official Project Orders (Active builds & milestones)
    match /orders/{orderId} {
      // Student can view their own order (by UID or email); Admin and Officers can view all
      allow read: if isAuthenticated() && (
        resource.data.clientId == request.auth.uid || 
        resource.data.clientEmail == request.auth.token.email ||
        isMasterAdmin() || 
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['admin', 'officer']
      );
      
      // Admin and Officers can create or update order milestones
      allow create, update: if isMasterAdmin() || 
        (isAuthenticated() && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['admin', 'officer']);
        
      // Master Admin can delete orders
      allow delete: if isMasterAdmin();
    }

    // 5. Client Reviews & Testimonials
    match /reviews/{reviewId} {
      // Public can see approved reviews; Admin can see all reviews
      allow read: if resource.data.approved == true || isMasterAdmin();
      
      // Any authenticated student can submit a review
      allow create: if isAuthenticated() && request.resource.data.approved == false;
      
      // Only Master Admin can approve, hide, or delete reviews
      allow update, delete: if isMasterAdmin();
    }

    // 6. Global Platform Stats
    match /platformStats/{statId} {
      // Public can read stats displayed on homepage
      allow read: if true;
      
      // Only Master Admin can update display numbers
      allow write: if isMasterAdmin();
    }

    // 7. Activity Logs & Audit Trail
    match /activityLogs/{logId} {
      // Internal logging permitted for active sessions
      allow create: if isAuthenticated();
      
      // Only Master Admin can inspect audit logs
      allow read: if isMasterAdmin();
      allow update, delete: if isMasterAdmin();
    }
  }
}
